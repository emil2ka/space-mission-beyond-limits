# Copy to .env.local (it is in .gitignore) and restart `pnpm dev`.
# Without these keys the game runs in local mode: players are tabs of one browser.
# Step by step: docs/04 Tech/Multiplayer.md → "How to connect Supabase".
# Project URL: Project Settings → API → Project URL
VITE_SUPABASE_URL=
# Public key: anon public (or Publishable key sb_publishable_…). NOT service_role / secret!
VITE_SUPABASE_ANON_KEY=
